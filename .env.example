# =============================================================================
# Musas Bienes Raíces — Environment (PLACEHOLDERS ONLY)
# =============================================================================
# Copy to .env.local and fill with keys from YOUR Musas dashboards.
# Do NOT reuse Biosite / other project secrets. Projects stay fully separate.
# =============================================================================

# --- Convex (create a NEW Convex project for Musas) ---
# After `npx convex dev`, Convex writes CONVEX_DEPLOYMENT / NEXT_PUBLIC_CONVEX_URL
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Clerk (create a NEW Clerk application for Musas) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Clerk Dashboard → Webhooks → endpoint https://YOUR_DOMAIN/api/clerk
# Events: user.created, user.updated
CLERK_WEBHOOK_SECRET=

# Shared secret for users.syncUser (Next webhook → Convex). Generate a random
# string; set the SAME value here AND in Convex Dashboard → Environment Variables.
USER_SYNC_SECRET=

# --- Convex Dashboard → Settings → Environment Variables ---
# Must match Clerk JWT issuer (Clerk → JWT Templates → "convex")
# CLERK_JWT_ISSUER_DOMAIN=https://YOUR-MUSAS-CLERK-INSTANCE.clerk.accounts.dev
# Optional comma-separated admin emails for role=admin on sync/ensure:
# ADMIN_EMAILS=tu@email.com
# Must match USER_SYNC_SECRET above (gates public syncUser mutation):
# USER_SYNC_SECRET=same-as-local

# --- UploadThing (create a NEW UploadThing app for Musas) ---
UPLOADTHING_TOKEN=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4321
# Ops contact for Preferencial leads (shown in admin; no payment)
NEXT_PUBLIC_OPS_EMAIL=
NEXT_PUBLIC_OPS_WHATSAPP=
